root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, kotlinx.**
ij_kotlin_name_count_to_use_star_import = 999
ij_kotlin_name_count_to_use_star_import_for_members = 999

# ktlint configuration
# Disabled to allow PascalCase for @Composable functions (Compose standard).
# Tracked for future refinement: https://github.com/pinterest/ktlint/issues/2448
ktlint_standard_function-naming = disabled
# Disabled to allow leading underscores for private backing properties (Kotlin standard).
# Tracked for future refinement: https://github.com/pinterest/ktlint/issues/1608
ktlint_standard_property-naming = disabled
